#version 450

// Normalised Cross-Correlation (no rotation)
// Simple, correct NCC implementation.

layout(set = 0, binding = 0) restrict readonly buffer TargetImage {
    float target_data[];
};

layout(set = 0, binding = 1) restrict readonly buffer TemplateImage {
    float template_data[];
};

layout(set = 0, binding = 2) restrict writeonly buffer ResultBuffer {
    vec4 results[];  // (correlation, rotation=0, _, _) per position
};

layout(set = 0, binding = 3) uniform CorrelationParams {
    uint target_width;
    uint target_height;
    uint template_width;
    uint template_height;
    float correlation_threshold;
    uint max_results;
    uint num_angles;
    uint padding;
} params;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uvec3 g_id = gl_GlobalInvocationID;
    uint out_w = params.target_width - params.template_width + 1;
    uint out_h = params.target_height - params.template_height + 1;

    if (g_id.x >= out_w || g_id.y >= out_h) return;

    uint out_idx = g_id.y * out_w + g_id.x;
    uint count = params.template_width * params.template_height;

    // Pass 1: Compute target patch mean
    float sum_f = 0.0;
    for (uint ty = 0; ty < params.template_height; ++ty) {
        for (uint tx = 0; tx < params.template_width; ++tx) {
            sum_f += target_data[(g_id.y + ty) * params.target_width + (g_id.x + tx)];
        }
    }
    float mean_f = sum_f / float(count);

    // Pass 2: Compute target patch std (numerically stable two-pass)
    float sum_sq_dev = 0.0;
    for (uint ty = 0; ty < params.template_height; ++ty) {
        for (uint tx = 0; tx < params.template_width; ++tx) {
            float dev = target_data[(g_id.y + ty) * params.target_width + (g_id.x + tx)] - mean_f;
            sum_sq_dev += dev * dev;
        }
    }
    float std_f = sqrt(max(sum_sq_dev / float(count), 1e-6));

    // Compute template mean and std (once per template, could be precomputed)
    float sum_t = 0.0;
    for (uint i = 0; i < count; ++i) {
        sum_t += template_data[i];
    }
    float mean_t = sum_t / float(count);
    
    float sum_sq_t = 0.0;
    for (uint i = 0; i < count; ++i) {
        float dev = template_data[i] - mean_t;
        sum_sq_t += dev * dev;
    }
    float std_t = sqrt(max(sum_sq_t / float(count), 1e-6));

    // Compute NCC: sum of (normalised_target * normalised_template)
    float ncc = 0.0;
    float norm_scale = 1.0 / (std_f * std_t * float(count));
    
    for (uint ty = 0; ty < params.template_height; ++ty) {
        for (uint tx = 0; tx < params.template_width; ++tx) {
            float target_val = target_data[(g_id.y + ty) * params.target_width + (g_id.x + tx)];
            float template_val = template_data[ty * params.template_width + tx];
            ncc += (target_val - mean_f) * (template_val - mean_t);
        }
    }
    ncc *= norm_scale;

    results[out_idx] = vec4(clamp(ncc, -1.0, 1.0), 0.0, 0.0, 0.0);
}
