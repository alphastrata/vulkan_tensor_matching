#version 450

// Peak Detection Shader for Tensorial Template Matching - Recalibrated version
// Martinez-Sanchez et al., arXiv:2408.02398v1 [cs.CV]
//
// Key fixes:
// 1. Boundary margin: Ignore peaks within half-template radius of image edges
// 2. Frobenius norm threshold: Use the new correlation metric

struct DetectionResult {
    uint x;
    uint y;
    uint correlation_fixed; // correlation * 10000 for precision
    uint rotation_fixed;    // rotation * 10000 for precision
    uint padding1;
    uint padding2;
    uint padding3;
    uint padding4;
};

layout(set = 0, binding = 0) restrict readonly buffer CorrelationMap {
    float correlation_data[];
};

layout(set = 0, binding = 1) restrict readonly buffer RotationMap {
    float rotation_data[];
};

layout(set = 0, binding = 2) restrict writeonly buffer DetectionResults {
    DetectionResult results[];
};

layout(set = 0, binding = 3) buffer AtomicCounter {
    uint peak_count;
} counter;

layout(set = 0, binding = 4) uniform PeakParams {
    uint width;
    uint height;
    float threshold;
    uint max_peaks;
    uint exclusion_radius;
    uint boundary_margin; // NEW: Half-template radius to avoid edge artifacts
    uint padding2;
    uint padding3;
} params;

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

void main() {
    uvec3 global_id = gl_GlobalInvocationID;

    if (global_id.x >= params.width || global_id.y >= params.height) {
        return;
    }

    // Boundary margin check: ignore peaks too close to image edges
    // This prevents false positives from normalization instability in flat regions
    if (global_id.x < params.boundary_margin || 
        global_id.x >= params.width - params.boundary_margin ||
        global_id.y < params.boundary_margin || 
        global_id.y >= params.height - params.boundary_margin) {
        return;
    }

    uint pixel_idx = global_id.y * params.width + global_id.x;
    float correlation = correlation_data[pixel_idx];

    if (correlation < params.threshold) {
        return;
    }

    // Check if this is a local maximum
    bool is_local_maximum = true;
    int r = int(params.exclusion_radius);

    for (int dy = -r; dy <= r; ++dy) {
        for (int dx = -r; dx <= r; ++dx) {
            if (dx == 0 && dy == 0) continue;

            int check_x = int(global_id.x) + dx;
            int check_y = int(global_id.y) + dy;

            if (check_x >= 0 && check_x < int(params.width) && check_y >= 0 && check_y < int(params.height)) {
                uint check_idx = uint(check_y) * params.width + uint(check_x);
                if (correlation_data[check_idx] > correlation) {
                    is_local_maximum = false;
                    break;
                }
                // Handle equal values by choosing the one with smaller index
                if (correlation_data[check_idx] == correlation && check_idx < pixel_idx) {
                    is_local_maximum = false;
                    break;
                }
            }
        }
        if (!is_local_maximum) break;
    }

    if (is_local_maximum) {
        uint slot = atomicAdd(counter.peak_count, 1);
        if (slot < params.max_peaks) {
            results[slot] = DetectionResult(
                global_id.x,
                global_id.y,
                uint(correlation * 10000.0),
                uint(rotation_data[pixel_idx] * 10000.0),
                0, 0, 0, 0
            );
        }
    }
}